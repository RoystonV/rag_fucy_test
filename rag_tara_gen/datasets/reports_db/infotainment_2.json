      },
      {
        "id": "derivation-2",
        "nodeId": "head-unit-os",
        "task": "Threat Analysis",
        "name": "CWE-15: External Control of System or Configuration Setting -> CAPEC-28: Privilege Escalation -> MITRE ATT&CK T1548.003: Abuse Elevation Control Mechanism: Sudo and Operating System Specific Transfer Utilities -> ATM: Control of System",
        "loss": "Unauthorized modification of system settings",
        "asset": "Head unit OS",
        "damage_scene": "An attacker exploits a vulnerability to gain external control over the infotainment system's configuration settings, potentially disabling safety features or altering critical parameters.",
        "isChecked": false
      },
      {
        "id": "derivation-3",
